---
import '../styles/global.css';
import Header from '../components/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import StickyCta from '../components/StickyCta.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showHeader?: boolean;
  showStructuredData?: boolean;
  showStickyCta?: boolean;
}

const {
  title = 'Alicante Bike Camp · Escuela Kesape MTB',
  description = '3 días en los mejores spots de Alicante. Reseteamos tu técnica con el Método Kesape para que dejes de sobrevivir y empieces a pilotar.',
  image = '/images/hero-trail.jpg',
  showHeader = true,
  showStructuredData = true,
  showStickyCta = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://escuelakesape.com');
const ogImage = new URL(image, Astro.site ?? 'https://escuelakesape.com');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:site_name" content="Escuela Kesape" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.toString()} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@1,600;1,700;1,900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {showStructuredData && <StructuredData />}

    <title>{title}</title>
  </head>
  <body>
    <a href="#que-es" class="skip-link">Saltar al contenido</a>
    {showHeader && <Header />}
    <slot />
    {showStickyCta && <StickyCta />}

    <script>
      // Stagger reveal: añade .is-revealed cuando el elemento entra en
      // viewport. CSS hace lo demás (transición + delay con --stagger-i).
      const items = document.querySelectorAll('[data-reveal]');
      if (items.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        items.forEach((item) => observer.observe(item));
      } else {
        // Fallback: sin IntersectionObserver, mostrar todo.
        items.forEach((item) => item.classList.add('is-revealed'));
      }
    </script>
    <style>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--color-accent);
        color: #000;
        padding: 0.5rem 1rem;
        z-index: 1000;
        font-weight: 600;
        border-radius: 0 0 var(--radius-md) 0;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </body>
</html>
