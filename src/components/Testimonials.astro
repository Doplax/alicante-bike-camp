---
// Testimonials · 12 shorts de YouTube extraídos de la landing original.
// Click → abre el short en un modal con iframe embebido (sin salir del sitio).
// Datos en src/data/testimonials.ts.
import { testimonialShorts as shorts } from '../data/testimonials';
---

<section id="testimonios" class="testimonials">
  <div class="container">
    <header class="testimonials__head">
      <span class="eyebrow">Quienes ya pasaron por aquí</span>
      <h2>Todos ellos ya lo han conseguido. ¿Y tú?</h2>
      <p class="muted">
        12 testimonios reales de riders que vinieron al camp. Toca cualquiera para reproducir.
      </p>
    </header>

    <div class="testimonials__grid">
      {shorts.map((id, i) => (
        <button
          type="button"
          class="short-card"
          data-short-id={id}
          aria-label={`Reproducir testimonio ${i + 1}`}
          data-reveal
          style={`--stagger-i: ${Math.min(i, 7)};`}
        >
          <img
            class="short-card__thumb"
            src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
            alt=""
            loading="lazy"
            decoding="async"
            width="480"
            height="360"
          />
          <span class="short-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" xmlns="http://www.w3.org/2000/svg">
              <rect
                x="6"
                y="2"
                width="12"
                height="20"
                rx="3"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
              />
              <path
                d="M10.5 8.2 L15.5 12 L10.5 15.8 Z"
                fill="currentColor"
              />
            </svg>
          </span>
        </button>
      ))}
    </div>
  </div>

  <div
    class="short-modal"
    data-short-modal
    role="dialog"
    aria-modal="true"
    aria-label="Reproductor de testimonio"
    hidden
  >
    <div class="short-modal__backdrop" data-short-close></div>
    <div class="short-modal__panel">
      <button
        type="button"
        class="short-modal__close"
        data-short-close
        aria-label="Cerrar reproductor"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
          />
        </svg>
      </button>
      <div class="short-modal__frame" data-short-frame></div>
    </div>
  </div>
</section>

<script>
  const modal = document.querySelector<HTMLElement>('[data-short-modal]');
  const frame = document.querySelector<HTMLElement>('[data-short-frame]');
  const cards = document.querySelectorAll<HTMLButtonElement>('.short-card');

  function openModal(id: string) {
    if (!modal || !frame) return;
    const params = new URLSearchParams({
      autoplay: '1',
      controls: '1',
      modestbranding: '1',
      rel: '0',
      playsinline: '1',
      loop: '1',
      playlist: id,
    });
    frame.innerHTML = `<iframe
      src="https://www.youtube-nocookie.com/embed/${id}?${params}"
      title="Testimonio"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>`;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !frame) return;
    modal.hidden = true;
    frame.innerHTML = '';
    document.body.style.overflow = '';
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const id = card.dataset.shortId;
      if (id) openModal(id);
    });
  });

  document.querySelectorAll('[data-short-close]').forEach((el) => {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
  });
</script>

<style>
  .testimonials__head {
    text-align: center;
    margin-bottom: var(--space-12);
    max-width: 720px;
    margin-inline: auto;
  }
  .testimonials__head .eyebrow {
    margin-bottom: var(--space-4);
  }
  .testimonials__head h2 {
    margin-bottom: var(--space-3);
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }
  @media (min-width: 980px) {
    .testimonials__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .short-card {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    padding: 0;
    font: inherit;
    color: inherit;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .short-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    opacity: 1;
  }

  .short-card__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.25s ease;
  }
  .short-card:hover .short-card__thumb {
    transform: scale(1.04);
    filter: brightness(0.78);
  }

  .short-card__icon {
    position: relative;
    z-index: 1;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(10, 10, 10, 0.72);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    transition: transform 0.25s ease, background-color 0.2s ease, color 0.2s ease;
  }
  .short-card:hover .short-card__icon {
    transform: scale(1.1);
    background: var(--color-accent);
    color: #0a0a0a;
  }

  .short-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
  .short-modal[hidden] { display: none; }

  .short-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .short-modal__panel {
    position: relative;
    width: min(420px, 100%);
    aspect-ratio: 9 / 16;
    max-height: calc(100vh - var(--space-8));
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }

  .short-modal__frame,
  .short-modal__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .short-modal__close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 0;
    background: rgba(10, 10, 10, 0.72);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .short-modal__close:hover {
    background: var(--color-accent);
    color: #0a0a0a;
    transform: scale(1.05);
  }
</style>
