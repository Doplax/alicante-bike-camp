---
// FAQ · datos en src/data/faqs.ts.
// Incluye C-05 (aclara monte vs bikepark) y O-05 (4 preguntas logísticas
// con respuestas seguras + TODO Kevin para confirmar detalles).
import { faqs } from '../data/faqs';
---

<section id="faq" class="faq">
  <div class="container container-narrow">
    <header class="faq__head">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2>Lo que más nos preguntan.</h2>
    </header>

    <div class="faq__list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-item__q">{faq.q}</summary>
          <div class="faq-item__a">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__head {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  .faq__head .eyebrow {
    margin-bottom: var(--space-4);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .faq-item:hover {
    border-color: var(--color-border-strong);
  }
  .faq-item[open] {
    border-color: rgba(74, 222, 42, 0.35);
  }

  .faq-item__q {
    list-style: none;
    cursor: pointer;
    padding: var(--space-4) var(--space-6);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-fg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    transition: color 0.2s ease;
  }
  .faq-item[open] .faq-item__q {
    color: var(--color-accent);
  }
  .faq-item__q::-webkit-details-marker {
    display: none;
  }
  .faq-item__q::after {
    content: '+';
    color: var(--color-accent);
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .faq-item[open] .faq-item__q::after {
    transform: rotate(45deg);
  }

  /* Animación moderna del contenido del <details>.
     Necesita interpolate-size: allow-keywords + ::details-content
     (Chrome 131+, Safari 18.4+). En navegadores sin soporte el
     desplegable funciona igual, solo sin transición. */
  .faq-item::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      block-size 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease,
      content-visibility 0.4s allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
  @starting-style {
    .faq-item[open]::details-content {
      block-size: 0;
      opacity: 0;
    }
  }

  .faq-item__a {
    padding: 0 var(--space-6) var(--space-6);
    color: var(--color-fg-muted);
    font-size: 0.98rem;
  }
  .faq-item__a p {
    margin: 0;
  }
</style>
