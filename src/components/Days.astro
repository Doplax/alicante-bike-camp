---
// Days · estructura unificada (propuesta C-02). Sustituye 3 secciones del original:
// "El Plan de Rescate", "¿Qué vas a aprender?" y "El Itinerario".
// Una sola tabla por día con lugar, horario, qué practicas y bloque metodológico.
// Datos en src/data/days.ts.
import { days } from '../data/days';
---

<section id="dias" class="days">
  <div class="container">
    <header class="days__head">
      <span class="eyebrow">Tu camp, día a día</span>
      <h2>Tres días, tres lugares, una progresión clara.</h2>
      <p class="muted">Del «pasajero» al «piloto». Sin atajos, sin foto bonita.</p>
    </header>

    <div class="days__grid">
      {days.map((day, i) => (
        <article class="day-card" data-reveal style={`--stagger-i: ${i};`}>
          {day.photo && (
            <div class="day-card__photo">
              <img src={day.photo} alt={day.photoAlt} loading="lazy" decoding="async" />
            </div>
          )}
          <header class="day-card__head">
            <span class="day-card__num">Día {day.n}</span>
            <h3 class="day-card__title">{day.name}</h3>
          </header>

          <div class="day-card__meta">
            <span class="day-card__pill">{day.weekday}</span>
            <span class="day-card__pill day-card__pill--accent">{day.location}</span>
            <span class="day-card__pill">{day.schedule}</span>
          </div>

          <p class="day-card__pitch">{day.pitch}</p>

          <div class="day-card__skills">
            <h4 class="day-card__subtitle">Qué practicas</h4>
            <ul>
              {day.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>

          <div class="day-card__blocks">
            {day.blocks.map((block) => (
              <span class="day-card__block">{block}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <aside class="days__note">
      <strong>Nota importante:</strong> los horarios son orientativos. Mandan el sol,
      la temperatura y tu fatiga. Adaptamos las horas para exprimir el día sin que el
      calor te agote. Si buscas un horario rígido para planificar la siesta, este no
      es tu sitio.
    </aside>
  </div>
</section>

<style>
  .days__head {
    text-align: center;
    margin-bottom: var(--space-16);
  }
  .days__head .eyebrow {
    margin-bottom: var(--space-4);
  }
  .days__head h2 {
    margin-bottom: var(--space-3);
  }

  .days__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .day-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    overflow: hidden;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .day-card__photo {
    margin: calc(-1 * var(--space-8)) calc(-1 * var(--space-8)) 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg);
  }
  .day-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .day-card:hover .day-card__photo img {
    transform: scale(1.04);
  }
  .day-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .day-card__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .day-card__num {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .day-card__title {
    color: var(--color-accent);
    font-size: 1.9rem;
  }

  .day-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .day-card__pill {
    font-size: 0.82rem;
    padding: 0.3rem 0.7rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-fg-muted);
  }

  .day-card__pill--accent {
    color: var(--color-fg);
    border-color: var(--color-border-strong);
  }

  .day-card__pitch {
    color: var(--color-fg-muted);
    font-size: 1rem;
    margin: 0;
  }

  .day-card__subtitle {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin: 0 0 var(--space-3);
  }

  .day-card__skills ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .day-card__skills li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.95rem;
  }

  .day-card__skills li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  .day-card__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .day-card__block {
    font-size: 0.8rem;
    color: var(--color-fg-subtle);
    font-style: italic;
  }

  .days__note {
    margin-top: var(--space-12);
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    color: var(--color-fg-muted);
    font-size: 0.95rem;
  }
  .days__note strong {
    color: var(--color-fg);
  }
</style>
