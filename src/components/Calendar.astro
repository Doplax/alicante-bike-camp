---
// Calendario · embed de Google Appointments para reservar una llamada
// previa con Kevin antes del camp.
const calendarUrl =
  'https://calendar.google.com/calendar/appointments/schedules/AcZssZ1MxHgQiRL7SLDguWyg-1bRVnb6S4_Qvwj8ZlH1s93TidQSCtMzHbprJsOIbh7bafTsuJ3aeXVb?gv=true';
---

<section id="agenda" class="calendar">
  <div class="container">
    <header class="calendar__head">
      <span class="eyebrow">¿Dudas antes de reservar?</span>
      <h2>Agenda una llamada con Kevin.</h2>
      <p class="muted">
        15 minutos para resolver tus dudas sobre el camp, tu nivel y si encajas. Sin compromiso.
      </p>
    </header>

    <div class="calendar__frame">
      <iframe
        src={calendarUrl}
        title="Agenda una llamada con Kevin"
        loading="lazy"
        frameborder="0"
      ></iframe>
    </div>

    <p class="calendar__fallback muted">
      ¿No carga el calendario?
      <a href={calendarUrl} target="_blank" rel="noopener">Ábrelo en una pestaña nueva</a>.
    </p>
  </div>
</section>

<style>
  .calendar__head {
    text-align: center;
    margin-bottom: var(--space-8);
    max-width: 720px;
    margin-inline: auto;
  }
  .calendar__head .eyebrow {
    margin-bottom: var(--space-4);
  }
  .calendar__head h2 {
    margin-bottom: var(--space-3);
  }

  .calendar__frame {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    height: 720px;
    max-width: 960px;
    margin-inline: auto;
  }

  .calendar__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .calendar__fallback {
    text-align: center;
    margin-top: var(--space-4);
    font-size: 0.9rem;
  }
  .calendar__fallback a {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .calendar__frame {
      height: 640px;
    }
  }
</style>
