---
// Calendario · CTA hacia Google Appointments para reservar una llamada
// previa con Kevin antes del camp.
const calendarUrl =
  'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1MxHgQiRL7SLDguWyg-1bRVnb6S4_Qvwj8ZlH1s93TidQSCtMzHbprJsOIbh7bafTsuJ3aeXVb';
---

<section id="agenda" class="calendar">
  <div class="container">
    <header class="calendar__head">
      <span class="eyebrow">¿Dudas antes de reservar?</span>
      <h2>Agenda una llamada con Kevin.</h2>
      <p class="muted">
        15 minutos por Google Meet para resolver tus dudas sobre el camp, tu nivel y si encajas. Sin compromiso.
      </p>
    </header>

    <div class="calendar__cta">
      <a
        class="btn btn-primary calendar__btn"
        href={calendarUrl}
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        Reservar llamada de 15 min
      </a>
      <p class="calendar__hint muted">Se abre Google Calendar en una pestaña nueva.</p>
    </div>
  </div>
</section>

<style>
  .calendar__head {
    text-align: center;
    margin-bottom: var(--space-8);
    max-width: 720px;
    margin-inline: auto;
  }
  .calendar__head .eyebrow {
    margin-bottom: var(--space-4);
  }
  .calendar__head h2 {
    margin-bottom: var(--space-3);
  }

  .calendar__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .calendar__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.05rem;
    padding: 1rem 1.8rem;
  }

  .calendar__hint {
    font-size: 0.85rem;
    margin: 0;
  }
</style>
